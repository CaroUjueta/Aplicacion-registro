rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function datosValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'email', 'telefono', 'enLinea', 'latitud', 'longitud', 'fotoPerfilUrl', 'ultimaActividad'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 100
        && d.email is string
        && d.telefono is string && d.telefono.size() <= 20
        && d.enLinea is bool
        && (!('latitud' in d) || d.latitud == null || (d.latitud is number && d.latitud >= -90 && d.latitud <= 90))
        && (!('longitud' in d) || d.longitud == null || (d.longitud is number && d.longitud >= -180 && d.longitud <= 180))
        && (!('fotoPerfilUrl' in d) || d.fotoPerfilUrl == null || d.fotoPerfilUrl is string)
        && (!('ultimaActividad' in d) || d.ultimaActividad is number);
    }

    match /perfilesMapa/{uid} {
      allow read: if signedIn();
      allow create, update: if esDueno(uid) && datosValidos();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
