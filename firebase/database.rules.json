{
  "rules": {
    "usuarios": {
      ".read": "auth != null",
      ".indexOn": ["enLinea"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nombre', 'email', 'telefono', 'enLinea'])",
        "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString()" },
        "telefono": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "enLinea": { ".validate": "newData.isBoolean()" },
        "latitud": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "longitud": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "fotoPerfilUrl": { ".validate": "newData.isString()" },
        "$otro": { ".validate": false }
      }
    }
  }
}
